# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database and Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/odissey
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/odissey
SEED_DEMO_DATA=false
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
CRON_SECRET=replace-with-at-least-24-random-characters

# Explicit administrator bootstrap
BOOTSTRAP_ADMIN=false
ADMIN_AUTH_USER_ID=00000000-0000-4000-8000-000000000000
ADMIN_EMAIL=owner@example.com
ADMIN_FULL_NAME=Propietario Odissey

# Resend
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=ventas@example.com

# Monitoring and analytics
SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=example-auth-token
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EXAMPLE123
