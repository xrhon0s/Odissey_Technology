# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database and Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/odissey
SEED_DEMO_DATA=false
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key

# Wompi
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_example
WOMPI_PRIVATE_KEY=prv_test_example
WOMPI_EVENTS_SECRET=test_events_example
WOMPI_INTEGRITY_SECRET=test_integrity_example

# Cloudinary
CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=example-api-key
CLOUDINARY_API_SECRET=example-api-secret

# Resend
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=ventas@example.com

# Monitoring and analytics
SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=example-auth-token
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EXAMPLE123
